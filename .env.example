DOCMAGIC_DB_PATH=/absolute/path/to/persistent/docmagic.db
# Alternative:
# DOCMAGIC_DATA_DIR=/absolute/path/to/persistent/data-dir
DOCMAGIC_DB_BASE_URL=https://bf56f3d8d0836b.lhr.life
DOCMAGIC_DB_PROXY=1
#
# Notes:
# - Use only one of DOCMAGIC_DB_PATH or DOCMAGIC_DATA_DIR.
# - If the app is deployed on a serverless platform without persistent disk
#   (for example Vercel), SQLite files under /tmp are temporary and will reset.
# - The shared DB bridge is provided through a reverse tunnel endpoint.
# - For true cloud persistence, replace SQLite with a managed external database service.
